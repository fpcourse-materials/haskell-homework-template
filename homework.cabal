cabal-version: 3.0
name:          homework
version:       0.1.0.0
license:       MIT
license-file:  LICENSE
author:        Andrey Stoyan
maintainer:    andrey.stoyan.csam@gmail.com
copyright:     2024-2026 Andrey Stoyan
build-type:    Simple
description:   Please see the README on GitHub at <https://github.com/fpcourse-materials/haskell-homework-template#readme>

extra-doc-files:
  README.md

common shared
  default-language: Haskell2010
  build-depends:
    , base >= 4.7 && < 5
    , GenericPretty
    , containers
    , pretty
    , random
  default-extensions:
    AllowAmbiguousTypes
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    EmptyCase
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    ImplicitParams
    ImportQualifiedPost
    InstanceSigs
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    OverloadedLabels
    PatternSynonyms
    PolyKinds
    QuantifiedConstraints
    QuasiQuotes
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilyDependencies
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    ViewPatterns
  ghc-options:
    -Wall
    -- to use hlint pragmas in source files
    -Wno-unrecognised-pragmas
    -- imported by teacher should not cause warnings
    -Wno-unused-imports
    -- teacher provides some constraints
    -Wno-redundant-constraints
    -- can be emitted by macro-generated code
    -Wno-noncanonical-monoid-instances
    -Wno-noncanonical-monad-instances
    -- just very inconvenient with helper functions
    -Wno-name-shadowing

library
  import: shared
  hs-source-dirs: src
  exposed-modules:
    Level1
    Level2
    Level3
  build-depends:
    meta-utils

library meta-utils
  import: shared
  hs-source-dirs: meta-utils/src
  exposed-modules:
    ClassDispatcher
    MetaUtils
    PP
    TodoException
    TodoMacro
  build-depends:
    template-haskell

test-suite meta-utils-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: meta-utils/test
  main-is: Spec.hs
  build-depends:
    , meta-utils
    , HUnit

-- Проверялка λ-домашек (hw01–hw03) — отдельный пакет lambda-engine/ (см. cabal.project):
-- библиотека Lambda.*, REPL `cabal run lambda -- load src/hw.lam`, свои тесты.
test-suite homework-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    SpecLevel1
    SpecLevel2
    SpecLevel3
    Test.Lambda
    Test.Lazy
    Test.Manifest
    Test.Prelude
    Test.Properties
    Test.Run
    Test.Utils
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -Wno-orphans
    -Wno-type-defaults
  build-depends:
    , meta-utils
    , homework
    , lambda-engine
    , directory
    , HUnit
    , QuickCheck
    , quickcheck-classes-base
    , generic-arbitrary
    , generic-random
    , deepseq
