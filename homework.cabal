cabal-version: 3.0
name:          homework
version:       0.1.0.0
license:       BSD-3-Clause
license-file:  LICENSE
author:        Andrey Stoyan
maintainer:    andrey.stoyan.csam@gmail.com
copyright:     2024 Andrey Stoyan
build-type:    Simple
description:   Please see the README on GitHub at <https://github.com/fpcourse-materials/haskell-homework-template#readme>

extra-doc-files:
  README.md

common shared
  default-language: Haskell2010
  build-depends:
    , base >= 4.7 && < 5
    , GenericPretty
    , containers
    , pretty
    , random
  default-extensions:
    AllowAmbiguousTypes
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    EmptyCase
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    ImplicitParams
    ImportQualifiedPost
    InstanceSigs
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    OverloadedLabels
    PatternSynonyms
    PolyKinds
    QuantifiedConstraints
    QuasiQuotes
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilyDependencies
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    ViewPatterns
  ghc-options:
    -Wall
    -- to use hlint pragmas in source files
    -Wno-unrecognised-pragmas
    -- imported by teacher should not cause warnings
    -Wno-unused-imports
    -- teacher provides some constraints
    -Wno-redundant-constraints
    -- can be emitted by macro-generated code
    -Wno-noncanonical-monoid-instances
    -Wno-noncanonical-monad-instances
    -- just very inconvenient with helper functions
    -Wno-name-shadowing

library
  import: shared
  hs-source-dirs: src
  exposed-modules:
    Block1
    Block2
    Block3
  build-depends:
    meta-utils

library meta-utils
  import: shared
  hs-source-dirs: meta-utils/src
  exposed-modules:
    ClassDispatcher
    MetaUtils
    PP
    TodoException
    TodoMacro
  build-depends:
    template-haskell

test-suite meta-utils-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: meta-utils/test
  main-is: Spec.hs
  build-depends:
    , meta-utils
    , HUnit

-- Проверялка λ-домашек (hw01–hw03): библиотека для автотестов и REPL.
-- Проверялка живёт и развивается здесь; своя секция без общих расширений шаблона.
library lambda-checker
  default-language: Haskell2010
  hs-source-dirs: meta-utils/lambda/src
  ghc-options: -Wall -Wcompat -Werror=incomplete-patterns
  exposed-modules:
    Lambda
    Lambda.Check
    Lambda.Color
    Lambda.Command
    Lambda.Decode
    Lambda.Eval
    Lambda.Explain
    Lambda.Parser
    Lambda.Pretty
    Lambda.Subst
    Lambda.Syntax
    Lambda.Types
  build-depends:
    , base >= 4.17 && < 5
    , filepath >= 1.4 && < 2
    , megaparsec >= 9.2 && < 10

-- REPL проверялки: cabal run lambda -- load src/hw.lam
executable lambda
  default-language: Haskell2010
  hs-source-dirs: meta-utils/lambda/app
  main-is: Main.hs
  ghc-options: -Wall
  build-depends:
    , base
    , haskeline >= 0.8 && < 0.9
    , lambda-checker
    , transformers

-- Собственные тесты проверялки; студенческий check.sh их не запускает.
test-suite lambda-test
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  hs-source-dirs: meta-utils/lambda/test
  main-is: Test.hs
  ghc-options: -Wall
  build-depends:
    , base
    , directory
    , lambda-checker

test-suite homework-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    SpecBlock1
    SpecBlock2
    SpecBlock3
    Test.Lambda
    Test.Lazy
    Test.Manifest
    Test.Prelude
    Test.Properties
    Test.Run
    Test.Utils
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -Wno-orphans
    -Wno-type-defaults
  build-depends:
    , meta-utils
    , homework
    , lambda-checker
    , directory
    , HUnit
    , QuickCheck
    , quickcheck-classes-base
    , generic-arbitrary
    , generic-random
    , deepseq
