-- Sample file: definitions, a task with checks, a chain.
-- Try: lambda check samples/basics.lam
--      lambda load samples/basics.lam   (then :follow twice succ 0)
language pure
vars x y

I = \x. x
K = \x y. x
S = \x y z. x z (y z)
succ = \n s z. s (n s z)

task 1.1 (twice)
twice = \f a. f (f a)
expect twice succ 0 = 2
expect twice (twice succ) 1 = 5

task 1.2 (S K K = I)
chain skk to I =
  S K K
  ~d~> (\x y z. x z (y z)) K K
  ~b~> (\y z. K z (y z)) K
  ~b~> \z. K z (K z)
  ~d~> \z. (\x y. x) z (K z)
  ~b~> \z. (\y. z) (K z)
  ~b~> \z. z

task 1.3 (a hole to fill)
compose = ...
expect compose succ succ 0 = 2
